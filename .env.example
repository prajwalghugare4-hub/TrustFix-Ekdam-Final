# ---------------------------------------------------------------------------
# TrustFix environment variables
# Copy this file to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------------------

# Frontend
PUBLIC_API_URL=http://localhost:5000/api

# Backend
PORT=5000
CLIENT_ORIGIN=http://localhost:4321

# MySQL connection — MySQL must be running on DB_HOST:DB_PORT.
# Keep DB_PORT at 3306 (5001 is used by OmniRoute and would clash).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Leave empty only when the MySQL user has no password.
DB_PASSWORD=
DB_NAME=trustfix

# Use a long random string in a real deployment
JWT_SECRET=trustfix-local-development-secret-change-me
JWT_EXPIRES_IN=7d
